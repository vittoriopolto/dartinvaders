# Copia questo file in ".env" (cp .env.example .env) e modificalo.

# Chiave segreta: in locale va bene questa, in produzione ne servirà una vera.
SECRET_KEY=cambiami-in-produzione

# 1 = sviluppo, 0 = produzione
DEBUG=1

# Nome della tua squadra, scritto come compare nei referti (maiuscole/minuscole non contano)
OUR_TEAM_NAME=Dart Invaders

# Database. Se lo lasci commentato, in locale usa un file SQLite (db.sqlite3).
# Per usare Neon: incolla la stringa di connessione (deve finire con ?sslmode=require)
# DATABASE_URL=postgresql://utente:password@host/dbname?sslmode=require
